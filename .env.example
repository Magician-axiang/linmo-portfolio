# ===== 复制本文件为 .env 并填入真实值 =====

# Postgres 数据库连接串
# 本地: postgres://user:pass@localhost:5432/portfolio
# Render: 平台自动注入，无需手填
# Railway/Supabase/Neon: 复制他们给的 DATABASE_URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

# 当数据库要求 SSL 时设为 require（Supabase/Neon/Render 外部连接通常需要）
PG_SSL=

# 会话加密密钥 — 任意一段足够长的随机字符串
SESSION_SECRET=please-change-me-to-a-long-random-string-1234567890

# 初始管理员账号（仅首次 seed 时用于创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 服务端口（云端平台会自动提供 PORT）
PORT=3000

# 公开访问地址（生成链接用）
PUBLIC_URL=http://localhost:3000
